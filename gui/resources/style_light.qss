/* MinePick Launcher — light theme (UI trial build)
 *
 * Palette: window #f2f5f8 · surface #ffffff · raised #f7f9fc
 *          border #d5dde6 · text #1f2a36 · muted #64748b · accent __ACCENT__
 *
 * Kept from the released theme on purpose (do not regress):
 *   - tabs are flat: no background block, no radius, text + green underline only
 *   - scrollbars stay invisible; the wheel still scrolls
 *   - focus outlines are suppressed (code-side delegate + QSS outline: none)
 *   - combo arrow / checkbox tick use PNG placeholders substituted in theme.py
 */

QMainWindow, QDialog { background: #f2f5f8; }

QWidget {
    color: #1f2a36;
    font-family: __FONT__;
    font-size: 13px;
}

/* ---------- text roles ---------- */

QLabel#hint { color: #64748b; }
QLabel#warning { color: #b03a2e; }
QLabel#title { font-size: 17px; font-weight: 700; }

/* ---------- panels: lists, tables, log views ---------- */

QListWidget, QTableWidget, QTableView, QPlainTextEdit, QTextEdit {
    background: #ffffff;
    border: 1px solid #d5dde6;
    border-radius: __RADIUS_LG__;
    padding: 4px;
    selection-background-color: __ACCENT_SEL__;
    selection-color: __ACCENT_SEL_TEXT__;
}

/* monospace only for log-like views: a plain text box (device code, notes) keeps the UI font */
QPlainTextEdit {
    font-family: "Cascadia Mono", Consolas, "Microsoft YaHei UI", monospace;
    font-size: 12px;
    padding: 8px 10px;
}
QTextEdit { padding: 6px 8px; }

/* ---------- inputs ---------- */

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background: #ffffff;
    border: 1px solid #d5dde6;
    border-radius: __RADIUS_SM__;
    padding: 6px 11px;
    min-height: 24px;
    selection-background-color: __ACCENT_SEL__;
    selection-color: __ACCENT_SEL_TEXT__;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover { border-color: #b9c5d2; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border: 1px solid __ACCENT__; }
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    color: #78838f;
    background: #f4f6f9;
}

/* ---------- tables ---------- */

QTableWidget, QTableView { gridline-color: #e6ebf1; }

QHeaderView::section {
    background: #f7f9fc;
    color: #64748b;
    border: none;
    border-bottom: 1px solid #d5dde6;
    padding: 8px;
    font-weight: 600;
}
/* Header corners stay square: rounding a section exposed the base style's light
   default background in the clipped notch (light-grey wedges at both top corners). */
QHeaderView { background: #f7f9fc; }
QTableCornerButton::section { background: #f7f9fc; border: none; }

QTableWidget::item, QTableView::item { padding: 7px 9px; border: none; }
QTableWidget::item:hover, QTableView::item:hover { background: __ACCENT_TINT__; }
QTableWidget::item:selected, QTableView::item:selected {
    background: __ACCENT_SEL__;
    color: __ACCENT_SEL_TEXT__;
    outline: none;
}

/* ---------- buttons ---------- */

/* White text sits on the readable fill (AA contrast), the pure accent stays for borders */
QPushButton {
    background: __ACCENT_BUTTON__;
    color: #ffffff;
    border: none;
    border-radius: __RADIUS_SM__;
    padding: 8px 18px;
    font-weight: 600;
}
QPushButton:hover { background: __ACCENT_BUTTON_HOVER__; }
QPushButton:pressed { background: __ACCENT_BUTTON_PRESS__; }
QPushButton:disabled { background: #e2e8ef; color: #9aa5b1; }
QPushButton:focus { outline: none; }

/* ---------- button variants: default = primary, plus secondary and danger ---------- */

QPushButton#secondaryButton {
    background: transparent;
    color: #33475c;
    border: 1px solid #c3ccd6;
    font-weight: 600;
}
QPushButton#secondaryButton:hover {
    background: #f1f6f3;
    border-color: __ACCENT__;
    color: #1f2a36;
}
QPushButton#secondaryButton:pressed { background: #e9eff5; }
QPushButton#secondaryButton:disabled {
    background: transparent;
    color: #9aa5b1;
    border-color: #e2e8ef;
}

QPushButton#dangerButton {
    background: transparent;
    color: #b03a2e;
    border: 1px solid #e0b3ad;
    font-weight: 600;
}
QPushButton#dangerButton:hover { background: #fbeceb; border-color: #b03a2e; }
QPushButton#dangerButton:pressed { background: #f5ddda; }
QPushButton#dangerButton:disabled {
    background: transparent;
    color: #c39a95;
    border-color: #eddad7;
}

/* ---------- status text severity ---------- */

QLabel#statusWarning { color: #8a6d1f; }
QLabel#statusError { color: #b03a2e; }

/* ---------- accent colour swatch in settings (outline follows the theme) ---------- */

QLabel#accentSwatch { border: 1px solid #c3ccd6; border-radius: 5px; }

/* ---------- list items (generic) ---------- */

QListWidget::item { padding: 9px 12px; border-radius: __RADIUS_SM__; margin: 2px 0; }
QListWidget::item:hover { background: __ACCENT_TINT__; }
QListWidget::item:selected,
QListWidget::item:selected:focus,
QListWidget::item:selected:!focus { background: __ACCENT_SEL__; color: __ACCENT_SEL_TEXT__; outline: none; }

/* ---------- sidebar navigation rail ---------- */

QListWidget#sidebar {
    background: transparent;
    border: none;
    padding: 6px 4px;
    outline: none;
}
QListWidget#sidebar::item {
    color: #64748b;
    padding: 10px 12px;
    margin: 3px 6px;
    border-radius: __RADIUS_LG__;
    border-left: 3px solid transparent;
    font-weight: 500;
}
QListWidget#sidebar::item:hover { background: #e9eff5; color: #1f2a36; }
/* Selected pill: rounded on both sides so the shape stays symmetric. */
QListWidget#sidebar::item:selected {
    background: __ACCENT_SOFT__;
    color: __ACCENT_SEL_TEXT__;
    border-left: 3px solid __ACCENT__;
    border-radius: __RADIUS_LG__;
    font-weight: 700;
}

/* ---------- progress ---------- */

QProgressBar {
    background: #ffffff;
    border: 1px solid #d5dde6;
    border-radius: __RADIUS_LG__;
    height: 16px;
    text-align: center;
    color: #64748b;
    font-size: 11px;
}
QProgressBar::chunk { background: __ACCENT__; border-radius: 7px; }

/* ---------- checkboxes ---------- */

QCheckBox { spacing: 8px; }
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #b9c5d2;
    border-radius: __RADIUS_XS__;
    background: #ffffff;
}
QCheckBox::indicator:hover { border-color: __ACCENT__; }
QCheckBox::indicator:checked {
    background: __ACCENT__;
    border-color: __ACCENT__;
    image: url(__CHECK__);
}
QCheckBox::indicator:checked:hover { background: __ACCENT_HOVER__; border-color: __ACCENT_HOVER__; }

/* ---------- status bar ---------- */

QStatusBar { background: #f2f5f8; color: #64748b; border-top: 1px solid #d5dde6; }
QStatusBar::item { border: none; }

/* ---------- tabs: flat, text + green underline only ---------- */

QTabWidget { background: #f2f5f8; }
QTabWidget::pane {
    border: none;
    border-radius: 0px;
    background: #f2f5f8;
}
QTabBar { background: transparent; }
QTabBar::tab {
    background: transparent;
    color: #64748b;
    padding: 9px 20px;
    border: none;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:hover { color: #1f2a36; }
QTabBar::tab:selected {
    color: __ACCENT_SEL_TEXT__;
    background: transparent;
    border-bottom: 2px solid __ACCENT__;
}

/* ---------- combo popup ---------- */

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border: none;
    background: transparent;
}
QComboBox::down-arrow {
    image: url(__DOWN_ARROW__);
    width: 10px;
    height: 6px;
    margin-right: 9px;
}
QComboBox QAbstractItemView {
    background: #ffffff;
    color: #1f2a36;
    border: 1px solid #d5dde6;
    border-radius: __RADIUS_LG__;
    padding: 4px;
    selection-background-color: __ACCENT_SEL__;
    selection-color: __ACCENT_SEL_TEXT__;
    outline: none;
}
QComboBox QAbstractItemView::item {
    padding: 9px 14px;
    min-height: 26px;
    border-radius: __RADIUS_SM__;
}

/* ---------- menus and tooltips ---------- */

QMenu {
    background: #ffffff;
    color: #1f2a36;
    border: 1px solid #d5dde6;
    border-radius: __RADIUS_LG__;
    padding: 6px;
}
QMenu::item { padding: 9px 28px; border-radius: __RADIUS_SM__; }
QMenu::item:selected { background: __ACCENT_SEL__; color: __ACCENT_SEL_TEXT__; }
QMenu::separator { height: 1px; background: #e6ebf1; margin: 5px 8px; }
QToolTip {
    background: #ffffff;
    color: #1f2a36;
    border: 1px solid #b9c5d2;
    border-radius: __RADIUS_SM__;
    padding: 5px 8px;
}

/* ---------- spin box buttons: flat ---------- */

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background: transparent;
    border: none;
    width: 20px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background: #e6ebf1;
}

/* ---------- scrollbars: invisible until the pointer enters the list, then a slim handle ---------- */

QScrollBar:vertical { background: transparent; width: 7px; margin: 0; }
QScrollBar:horizontal { background: transparent; height: 7px; margin: 0; }
/* No min-height / min-width here on purpose: those propagate into the scroll area's own
   minimum size and made the account page 17px taller than the 1000x600 window. */
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: transparent;
    border: none;
    border-radius: 3px;
}
QScrollBar[active="true"]::handle:vertical,
QScrollBar[active="true"]::handle:horizontal { background: #b9c5d2; }
QScrollBar[active="true"]::handle:vertical:hover,
QScrollBar[active="true"]::handle:horizontal:hover { background: __ACCENT__; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; background: transparent; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ---------- scroll area keeps the page background ---------- */

QScrollArea { background: transparent; border: none; }
QScrollArea > QWidget > QWidget { background: transparent; }

/* ---------- grouped form sections ---------- */

QGroupBox {
    border: 1px solid #d5dde6;
    border-radius: __RADIUS_LG__;
    margin-top: 14px;
    padding: 14px 12px 12px 12px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #64748b;
    font-weight: 600;
}

/* ---------- versions page: category chips + latest cards ---------- */

QPushButton#categoryTab {
    background: transparent;
    color: #64748b;
    border: 1px solid transparent;
    border-radius: 15px;
    padding: 7px 17px;
    font-weight: 500;
}
QPushButton#categoryTab:hover { color: #1f2a36; background: #e9eff5; }
QPushButton#categoryTab:checked {
    background: __ACCENT_BUTTON__;
    color: #ffffff;
    border-color: __ACCENT_BUTTON__;
    font-weight: 700;
}

/* Uniform border width on purpose: a thicker left border pokes out of the rounded
   corner in Qt, so the emphasis comes from the accent-colored 1px border instead. */
QFrame#latestCard {
    background: #ffffff;
    border: 1px solid __ACCENT__;
    border-radius: __RADIUS_LG__;
}
QLabel#latestKind { color: #64748b; font-size: 12px; }
QLabel#latestVersion { font-size: 16px; font-weight: 700; color: #1f2a36; }

/* ---------- page header ---------- */

QWidget#pageHeader { background: transparent; }
QLabel#pageTitle { font-size: 18px; font-weight: 700; color: #16202b; }
QLabel#pageSubtitle { color: #64748b; font-size: 11px; }

/* ---------- sidebar brand ---------- */


/* ---------- empty state ---------- */

QLabel#emptyState {
    color: #677585;
    font-size: 12px;
    padding: 16px 10px;
    background: transparent;
}

/* ---------- keyboard focus: only shown when navigating with the keyboard ---------- */

QListWidget[keyboardFocus="true"], QTableView[keyboardFocus="true"], QTableWidget[keyboardFocus="true"],
QPlainTextEdit[keyboardFocus="true"], QTextEdit[keyboardFocus="true"], QComboBox[keyboardFocus="true"],
QLineEdit[keyboardFocus="true"], QSpinBox[keyboardFocus="true"], QDoubleSpinBox[keyboardFocus="true"] {
    border: 1px solid __ACCENT__;
}
QPushButton[keyboardFocus="true"] { background: __ACCENT_HOVER__; }
QPushButton#secondaryButton[keyboardFocus="true"], QPushButton#dangerButton[keyboardFocus="true"] {
    border: 1px solid __ACCENT__;
}

/* ---------- custom title bar (frameless window) ---------- */

QWidget#titleBar {
    background: #f2f5f8;
    border-bottom: 1px solid #d5dde6;
}
QLabel#titleBarTitle { color: #1f2a36; font-size: 13px; font-weight: 600; }

QPushButton#titleBarMinimize, QPushButton#titleBarClose {
    background: transparent;
    border: none;
    border-radius: __RADIUS_SM__;
    color: #64748b;
    font-size: 13px;
    padding: 0;
}
QPushButton#titleBarMinimize:hover {
    background: #dfe6ee;
    color: #1f2a36;
}
QPushButton#titleBarClose:hover { background: #d64545; color: #ffffff; }

/* ---------- frameless window: root and content keep the window background ---------- */

QWidget#appRoot, QWidget#appContent { background: #f2f5f8; }

/* ---------- first-run wizard overlay ---------- */

QWidget#wizardOverlay { background: #f2f5f8; }
QWidget#wizardCard {
    background: #ffffff;
    border: none;
    border-radius: 0;
}
QLabel#wizardHeading { font-size: 19px; font-weight: 700; color: #16202b; }
QLabel#wizardHeadingBig { font-size: 26px; font-weight: 700; color: #16202b; }
QLabel#wizardDescription { color: #64748b; font-size: 13px; }
QLabel#wizardDot { background: #c3ccd6; border-radius: 4px; }
QLabel#wizardDot[current="true"] { background: __ACCENT__; }

/* ---------- wizard: rail, action bar, bigger buttons ---------- */

QWidget#wizardRail { background: #f7f9fc; border-right: 1px solid #d5dde6; }
QLabel#wizardRailItem { color: #8394a6; font-size: 13px; padding: 9px 6px; }
QLabel#wizardRailItem[state="current"] { color: #16202b; font-weight: 700; }
QLabel#wizardRailItem[state="done"] { color: #64748b; }
QWidget#wizardContent { background: #ffffff; }
QWidget#wizardActionBar { background: #f7f9fc; border-top: 1px solid #d5dde6; }
QWidget#wizardActionBar QPushButton {
    min-height: 40px;
    padding: 0 24px;
    font-size: 14px;
    border-radius: __RADIUS_SM__;
}
QPushButton#wizardOption, QPushButton#wizardBrowse {
    background: #f7f9fc;
    border: 1px solid #d5dde6;
    border-radius: __RADIUS_SM__;
    color: #26313d;
    padding: 10px 12px;
    font-weight: 500;
    min-height: 22px;
}
QPushButton#wizardOption:hover, QPushButton#wizardBrowse:hover { border-color: #b9c5d2; color: #14503a; }
QPushButton#wizardOption[selected="true"] {
    background: __ACCENT_SOFT__;
    border: 1px solid __ACCENT__;
    color: #14503a;
    font-weight: 700;
}
QLabel#wizardStatus { color: #64748b; font-size: 12px; }
QLabel#wizardBullet { color: #26313d; font-size: 13px; }
QDoubleSpinBox#wizardMemory { min-height: 30px; }
QDoubleSpinBox#wizardMemory::up-button, QDoubleSpinBox#wizardMemory::down-button {
    background: #d5dde6;
    border: none;
    width: 22px;
}
QDoubleSpinBox#wizardMemory::up-button:hover, QDoubleSpinBox#wizardMemory::down-button:hover {
    background: #b9c5d2;
}
