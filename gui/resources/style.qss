/* MinePick Launcher — dark theme
 *
 * This sheet holds no colour literals: every colour is a token placeholder resolved by gui/theme.py
 * (NEUTRAL_TOKENS + accent_palette), so one token carries a value per theme and the palette
 * lives in exactly one place. See MinePick_UI_实现规范.md §2.7.
 * Unresolved placeholders are caught by tests/test_qss_tokens.py.
 *
 * Kept from the released theme on purpose (do not regress):
 *   - tabs are flat: no background block, no radius, text + green underline only
 *   - scrollbars stay invisible; the wheel still scrolls
 *   - focus outlines are suppressed (code-side delegate + QSS outline: none)
 *   - combo arrow / checkbox tick use PNG placeholders substituted in theme.py
 */

QMainWindow, QDialog { background: __BG_WINDOW__; }

QWidget {
    color: __FG_TEXT__;
    font-family: __FONT__;
    font-size: 13px;
}

/* ---------- text roles ---------- */

QLabel#hint { color: __FG_HINT__; }
QLabel#warning { color: __DANGER_FG__; }
QLabel#title { font-size: 18px; font-weight: 700; }

/* ---------- panels: lists, tables, log views ---------- */

QListWidget, QTableWidget, QTableView, QPlainTextEdit, QTextEdit {
    background: __BG_LIST__;
    border: 1px solid __BORDER_LIST__;
    border-radius: __RADIUS_LG__;
    padding: 4px;
    selection-background-color: __ACCENT_SEL__;
    selection-color: __FG_SELECTED__;
}

/* monospace only for log-like views: a plain text box (device code, notes) keeps the UI font */
QPlainTextEdit {
    font-family: "Cascadia Mono", Consolas, "Microsoft YaHei UI", monospace;
    font-size: 12px;
    padding: 8px 8px;
}
QTextEdit { padding: 4px 8px; }

/* ---------- inputs ---------- */

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background: __BG_LIST__;
    border: 1px solid __BORDER_LIST__;
    border-radius: __RADIUS_SM__;
    padding: 4px 12px;
    min-height: 24px;
    selection-background-color: __ACCENT_SEL__;
    selection-color: __FG_SELECTED__;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover { border-color: __BORDER_HOVER__; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border: 1px solid __ACCENT__; }
/* Containers that can hold focus need a visible focus state of their own (UI guideline 5.1). They
   keep a 1px transparent border even at rest, so colouring it cannot shift the layout (3.3). */
QTextEdit:focus, QTableWidget:focus, QTableView:focus, QScrollArea:focus { border: 1px solid __ACCENT__; }
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    color: __FG_DISABLED_2__;
    background: __BG_DISABLED__;
}

/* ---------- tables ---------- */

QTableWidget, QTableView { gridline-color: __BORDER_TABLE__; }

QHeaderView::section {
    background: __BG_SECTION__;
    color: __FG_HINT__;
    border: none;
    border-bottom: 1px solid __BORDER_LIST__;
    padding: 8px;
    font-weight: 600;
}
/* Header corners stay square: rounding a section exposed the base style's light
   default background in the clipped notch (light-grey wedges at both top corners). */
QHeaderView { background: __BG_SECTION__; }
QTableCornerButton::section { background: __BG_SECTION__; border: none; }

QTableWidget::item, QTableView::item { padding: 8px 8px; border: none; }
QTableWidget::item:hover, QTableView::item:hover { background: __BG_HOVER__; }
QTableWidget::item:selected, QTableView::item:selected {
    background: __ACCENT_SEL__;
    color: __FG_SELECTED__;
    outline: none;
}

/* ---------- buttons ---------- */

/* White text sits on the readable fill (AA contrast), the pure accent stays for borders */
QPushButton {
    background: __ACCENT_BUTTON__;
    color: __FG_SELECTED__;
    border: none;
    border-radius: __RADIUS_SM__;
    padding: 8px 16px;
    font-weight: 600;
}
QPushButton:hover { background: __ACCENT_BUTTON_HOVER__; }
QPushButton:pressed { background: __ACCENT_BUTTON_PRESS__; }
QPushButton:disabled { background: __BG_DISABLED_2__; color: __FG_DISABLED__; }
QPushButton:focus { outline: none; }

/* ---------- button variants: default = primary, plus secondary and danger ---------- */

QPushButton#secondaryButton {
    background: transparent;
    color: __FG_BUTTON_SECONDARY__;
    border: 1px solid __BORDER_BUTTON_SECONDARY__;
    font-weight: 600;
}
QPushButton#secondaryButton:hover {
    background: __BG_BUTTON_SECONDARY__;
    border-color: __ACCENT__;
    color: __FG_TEXT__;
}
QPushButton#secondaryButton:pressed { background: __BG_BUTTON_SECONDARY_2__; }
QPushButton#secondaryButton:disabled {
    background: transparent;
    color: __FG_DISABLED__;
    border-color: __BORDER_BUTTON_SECONDARY_2__;
}

QPushButton#dangerButton {
    background: transparent;
    color: __DANGER_FG__;
    border: 1px solid __DANGER_BORDER__;
    font-weight: 600;
}
QPushButton#dangerButton:hover { background: __DANGER_BG__; border-color: __DANGER_BORDER_2__; }
QPushButton#dangerButton:pressed { background: __DANGER_BG_2__; }
QPushButton#dangerButton:disabled {
    background: transparent;
    color: __DANGER_FG_2__;
    border-color: __DANGER_BORDER_3__;
}

/* ---------- status text severity ---------- */

QLabel#statusWarning { color: __FG_STATUS_WARNING__; }
QLabel#statusError { color: __DANGER_FG__; }

/* ---------- accent colour swatch in settings (outline follows the theme) ---------- */

QLabel#accentSwatch { border: 1px solid __BORDER_SWATCH__; border-radius: 5px; }

/* ---------- list items (generic) ---------- */

QListWidget::item { padding: 8px 12px; border-radius: __RADIUS_SM__; margin: 0 0; }
QListWidget::item:hover { background: __BG_HOVER__; }
QListWidget::item:selected,
QListWidget::item:selected:focus,
QListWidget::item:selected:!focus { background: __ACCENT_SEL__; color: __FG_SELECTED__; outline: none; }

/* ---------- sidebar navigation rail ---------- */

QListWidget#sidebar {
    background: transparent;
    border: 1px solid transparent;
    padding: 4px 4px;
    outline: none;
}
/* The rail itself carries the keyboard focus cue: Qt repaints a view's own border on focus, while the
   selected item's pseudo-state `:focus` proved unreliable for list items. */
QListWidget#sidebar:focus {
    border-color: __ACCENT__;
}
QListWidget#sidebar::item {
    color: __FG_HINT__;
    padding: 8px 12px;
    margin: 4px 4px;
    border-radius: __RADIUS_LG__;
    border-left: 3px solid transparent;
    font-weight: 500;
}
QListWidget#sidebar::item:hover { background: __BG_SIDEBAR__; color: __FG_TEXT__; }
/* Selected pill: rounded on both sides so the shape stays symmetric. */
QListWidget#sidebar::item:selected {
    background: __ACCENT_SOFT__;
    color: __FG_SELECTED__;
    border-left: 3px solid __ACCENT__;
    border-radius: __RADIUS_LG__;
    font-weight: 700;
}

/* ---------- progress ---------- */

QProgressBar {
    background: __BG_LIST__;
    border: 1px solid __BORDER_LIST__;
    border-radius: __RADIUS_LG__;
    height: 16px;
    text-align: center;
    color: __FG_HINT__;
    font-size: 11px;
}
QProgressBar::chunk { background: __ACCENT__; border-radius: 7px; }

/* ---------- checkboxes ---------- */

QCheckBox { spacing: 8px; }
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid __BORDER_HOVER__;
    border-radius: __RADIUS_XS__;
    background: __BG_LIST__;
}
QCheckBox::indicator:hover { border-color: __ACCENT__; }
QCheckBox::indicator:checked {
    background: __ACCENT__;
    border-color: __ACCENT__;
    image: url(__CHECK__);
}
QCheckBox::indicator:checked:hover { background: __ACCENT_HOVER__; border-color: __ACCENT_HOVER__; }

/* ---------- status bar ---------- */

QStatusBar { background: __BG_WINDOW__; color: __FG_HINT__; border-top: 1px solid __BORDER_LIST__; }
QStatusBar::item { border: none; }

/* ---------- tabs: flat, text + green underline only ---------- */

QTabWidget { background: __BG_WINDOW__; }
QTabWidget::pane {
    border: none;
    border-radius: 0px;
    background: __BG_WINDOW__;
}
QTabBar { background: transparent; }
QTabBar::tab {
    background: transparent;
    color: __FG_HINT__;
    padding: 8px 16px;
    border: none;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:hover { color: __FG_TEXT__; }
QTabBar::tab:selected {
    color: __FG_SELECTED__;
    background: transparent;
    border-bottom: 2px solid __ACCENT__;
}

/* ---------- combo popup ---------- */

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border: none;
    background: transparent;
}
QComboBox::down-arrow {
    image: url(__DOWN_ARROW__);
    width: 10px;
    height: 6px;
    margin-right: 8px;
}
QComboBox QAbstractItemView {
    background: __BG_LIST_2__;
    color: __FG_TEXT__;
    border: 1px solid __BORDER_LIST__;
    border-radius: __RADIUS_LG__;
    padding: 4px;
    selection-background-color: __ACCENT_SEL__;
    selection-color: __FG_SELECTED__;
    outline: none;
}
QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    min-height: 26px;
    border-radius: __RADIUS_SM__;
}

/* ---------- menus and tooltips ---------- */

QMenu {
    background: __BG_LIST_2__;
    color: __FG_TEXT__;
    border: 1px solid __BORDER_LIST__;
    border-radius: __RADIUS_LG__;
    padding: 4px;
}
QMenu::item { padding: 8px 24px; border-radius: __RADIUS_SM__; }
QMenu::item:selected { background: __ACCENT_SEL__; color: __FG_SELECTED__; }
QMenu::separator { height: 1px; background: __BG_SEPARATOR__; margin: 4px 8px; }
QToolTip {
    background: __BG_LIST_2__;
    color: __FG_TEXT__;
    border: 1px solid __BORDER_HOVER__;
    border-radius: __RADIUS_SM__;
    padding: 4px 8px;
}

/* ---------- spin box buttons: flat ---------- */

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background: transparent;
    border: none;
    width: 20px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background: __BG_SEPARATOR__;
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    image: url(__SPIN_UP__);
    /* follow the field's own radius, so a rounded input never shows a square button */
    border-top-right-radius: __RADIUS_SM__;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    image: url(__SPIN_DOWN__);
    border-bottom-right-radius: __RADIUS_SM__;
}


/* ---------- scrollbars: invisible until the pointer enters the list, then a slim handle ---------- */

QScrollBar:vertical { background: transparent; width: 7px; margin: 0; }
QScrollBar:horizontal { background: transparent; height: 7px; margin: 0; }
/* No min-height / min-width here on purpose: those propagate into the scroll area's own
   minimum size and made the account page 17px taller than the 1000x600 window. */
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: transparent;
    border: none;
    border-radius: 3px;
}
QScrollBar[active="true"]::handle:vertical,
QScrollBar[active="true"]::handle:horizontal { background: __BG_SCROLLBAR__; }
QScrollBar[active="true"]::handle:vertical:hover,
QScrollBar[active="true"]::handle:horizontal:hover { background: __ACCENT__; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; background: transparent; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ---------- scroll area keeps the page background ---------- */

QScrollArea { background: transparent; border: 1px solid transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }

/* ---------- grouped form sections ---------- */

QGroupBox {
    border: 1px solid __BORDER_LIST__;
    border-radius: __RADIUS_LG__;
    margin-top: 12px;
    padding: 12px 12px 12px 12px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: __FG_HINT__;
    font-weight: 700;
}

/* ---------- versions page: category chips + latest cards ---------- */

QPushButton#categoryTab {
    background: transparent;
    color: __FG_HINT__;
    border: 1px solid transparent;
    border-radius: 15px;
    padding: 8px 16px;
    font-weight: 500;
}
QPushButton#categoryTab:hover { color: __FG_TEXT__; background: __BG_SIDEBAR__; }
QPushButton#categoryTab:checked {
    background: __ACCENT_BUTTON__;
    color: __FG_SELECTED__;
    border-color: __ACCENT_BUTTON__;
    font-weight: 700;
}

/* Keyboard focus must survive the id rule: `QPushButton:focus` loses to `QPushButton#categoryTab`.
   The base rule already has `border: 1px solid transparent`, so colouring it shifts no layout, and
   this rule stays distinguishable from the checked state (which fills the pill). */
QPushButton#categoryTab:focus {
    border-color: __ACCENT__;
    color: __FG_TEXT__;
}

/* Uniform border width on purpose: a thicker left border pokes out of the rounded
   corner in Qt, so the emphasis comes from the accent-colored 1px border instead. */
QFrame#latestCard {
    background: __BG_LIST_2__;
    border: 1px solid __ACCENT__;
    border-radius: __RADIUS_LG__;
}
QLabel#latestKind { color: __FG_HINT__; font-size: 12px; }
QLabel#latestVersion { font-size: 16px; font-weight: 700; color: __FG_CARD_LATEST__; }

/* ---------- icon-only buttons (launch page: switch account) ---------- */

QPushButton#iconButton {
    background: transparent;
    border: 1px solid __BORDER_BUTTON_ICON__;
    border-radius: __RADIUS_SM__;
    padding: 4px;
}
QPushButton#iconButton:hover { background: __BG_BUTTON_ICON__; border-color: __ACCENT__; }
QPushButton#iconButton:pressed { background: __BG_BUTTON_ICON_2__; }
/* The button is borderless at rest, so the generic QPushButton:focus rule cannot show through: an
   id-scoped rule wins. The 1px border already exists at rest, so focusing shifts nothing. */
QPushButton#iconButton:focus { border: 1px solid __ACCENT__; }

/* ---------- in-window overlay dialogs (crash diagnosis) ---------- */

QWidget#overlayCard {
    background: __BG_LIST__;
    border: 1px solid __BORDER_BUTTON_ICON__;
    border-radius: __RADIUS_LG__;
}
QLabel#overlayCode {
    color: __FG_OVERLAY_CODE__;
    background: __BG_OVERLAY_CODE__;
    border: 1px solid __BORDER_OVERLAY_CODE__;
    border-radius: __RADIUS_SM__;
    padding: 0 8px;
    font-weight: 700;
}
QLabel#overlayBody { color: __FG_OVERLAY_BODY__; }
QScrollArea#overlayScroll { background: transparent; }

/* ---------- page header ---------- */

QWidget#pageHeader { background: transparent; }
QLabel#pageTitle { font-size: 18px; font-weight: 700; color: __FG_PAGE_TITLE__; }
QLabel#pageSubtitle { color: __FG_HINT__; font-size: 11px; }

/* ---------- sidebar brand ---------- */


/* ---------- empty state ---------- */

QLabel#emptyState {
    color: __FG_EMPTY_STATE__;
    font-size: 12px;
    padding: 16px 8px;
    background: transparent;
}

/* ---------- keyboard focus: only shown when navigating with the keyboard ---------- */

QListWidget[keyboardFocus="true"], QTableView[keyboardFocus="true"], QTableWidget[keyboardFocus="true"],
QPlainTextEdit[keyboardFocus="true"], QTextEdit[keyboardFocus="true"], QComboBox[keyboardFocus="true"],
QLineEdit[keyboardFocus="true"], QSpinBox[keyboardFocus="true"], QDoubleSpinBox[keyboardFocus="true"] {
    border: 1px solid __ACCENT__;
}
QPushButton[keyboardFocus="true"] { background: __ACCENT_HOVER__; }
QPushButton#secondaryButton[keyboardFocus="true"], QPushButton#dangerButton[keyboardFocus="true"] {
    border: 1px solid __ACCENT__;
}

/* ---------- custom title bar (frameless window) ---------- */

QWidget#titleBar {
    background: __BG_WINDOW__;
    border-bottom: 1px solid __BORDER_LIST__;
}
QLabel#titleBarTitle { color: __FG_TEXT__; font-size: 13px; font-weight: 600; }

QPushButton#titleBarMinimize, QPushButton#titleBarClose {
    background: transparent;
    border: none;
    border-radius: __RADIUS_SM__;
    color: __FG_HINT__;
    font-size: 13px;
    padding: 0;
}
QPushButton#titleBarMinimize:hover {
    background: __BG_TITLEBAR_MINIMIZE__;
    color: __FG_TEXT__;
}
QPushButton#titleBarClose:hover { background: __BG_TITLEBAR_CLOSE__; color: __FG_SELECTED__; }

/* ---------- frameless window: root and content keep the window background ---------- */

QWidget#appRoot, QWidget#appContent { background: __BG_WINDOW__; }

/* ---------- first-run wizard overlay ---------- */

QWidget#wizardOverlay { background: __BG_WINDOW__; }
QWidget#wizardCard {
    background: __BG_WINDOW__;
    border: none;
    border-radius: 0;
}
QLabel#wizardHeading { font-size: 19px; font-weight: 700; color: __FG_PAGE_TITLE__; }
QLabel#wizardHeadingBig { font-size: 26px; font-weight: 700; color: __FG_PAGE_TITLE__; }
QLabel#wizardDescription { color: __FG_HINT__; font-size: 13px; }
QLabel#wizardDot { background: __BG_RAIL_DOT__; border-radius: 4px; }
QLabel#wizardDot[current="true"] { background: __ACCENT__; }

/* ---------- wizard: rail, action bar, bigger buttons ---------- */

QWidget#wizardRail { background: __BG_WINDOW__; border-right: 1px solid __BORDER_LIST__; }
QLabel#wizardRailItem { color: __FG_RAIL_ITEM__; font-size: 13px; padding: 8px 4px; }
QLabel#wizardRailItem[state="current"] { color: __FG_PAGE_TITLE__; font-weight: 700; }
QLabel#wizardRailItem[state="done"] { color: __FG_HINT__; }
QWidget#wizardContent { background: __BG_WINDOW__; }
QWidget#wizardActionBar { background: __BG_WINDOW__; border-top: 1px solid __BORDER_LIST__; }
QWidget#wizardActionBar QPushButton {
    min-height: 40px;
    padding: 0 24px;
    font-size: 14px;
    border-radius: __RADIUS_SM__;
}
QPushButton#wizardOption, QPushButton#wizardBrowse {
    background: __BG_OPTION__;
    border: 1px solid __BORDER_LIST__;
    border-radius: __RADIUS_SM__;
    color: __FG_OPTION__;
    padding: 8px 12px;
    font-weight: 500;
    min-height: 22px;
}
QPushButton#wizardOption:hover, QPushButton#wizardBrowse:hover { border-color: __BORDER_HOVER__; color: __FG_OPTION_2__; }
QPushButton#wizardOption[selected="true"] {
    background: __ACCENT_SOFT__;
    border: 1px solid __ACCENT__;
    color: __FG_OPTION_2__;
    font-weight: 700;
}
QLabel#wizardStatus { color: __FG_HINT__; font-size: 12px; }
QLabel#wizardBullet { color: __FG_OPTION__; font-size: 13px; }
QDoubleSpinBox#wizardMemory { min-height: 30px; }
